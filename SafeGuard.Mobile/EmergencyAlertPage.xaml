<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeGuard.Mobile.EmergencyAlertPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#050505">

    <Grid>
        <BoxView>
            <BoxView.Background>
                <RadialGradientBrush Center="0.5,0.4" Radius="0.8">
                    <GradientStop Color="#A01D1D" Offset="0.1" />
                    <GradientStop Color="#000000" Offset="1.0" />
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Image Source="hex_pattern.png" 
               Aspect="AspectFill" 
               Opacity="0.05" 
               HorizontalOptions="FillAndExpand" 
               VerticalOptions="FillAndExpand"
               InputTransparent="True"/>

        <BoxView x:Name="PulseRing1" Color="#FF0000" CornerRadius="150" 
                 HeightRequest="300" WidthRequest="300" 
                 HorizontalOptions="Center" VerticalOptions="Center" 
                 Opacity="0" InputTransparent="True"/>

        <BoxView x:Name="PulseRing2" Color="#FF0000" CornerRadius="150" 
                 HeightRequest="300" WidthRequest="300" 
                 HorizontalOptions="Center" VerticalOptions="Center" 
                 Opacity="0" InputTransparent="True"/>

        <Grid RowDefinitions="*, Auto" Padding="20">

            <Border x:Name="SosIconBorder" 
                    Grid.Row="0"
                    WidthRequest="160" HeightRequest="160"
                    StrokeShape="RoundRectangle 80"
                    BackgroundColor="#AA0000"
                    Stroke="#FF3333" StrokeThickness="3"
                    HorizontalOptions="Center" VerticalOptions="Center">

                <Border.Shadow>
                    <Shadow Brush="Red" Offset="0,0" Radius="100" Opacity="1" />
                </Border.Shadow>

                <Image Source="sos_icon.png" 
                       WidthRequest="80" HeightRequest="80" 
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Border Grid.Row="1" 
                    BackgroundColor="#1A1A1A" 
                    Stroke="#333" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label x:Name="SenderNameLabel" 
                               Text="YÜKLENİYOR..." 
                               TextColor="White" FontSize="26" FontAttributes="Bold" 
                               HorizontalTextAlignment="Center"/>

                        <Label x:Name="LocationLabel" 
                               Text="📍 Konum Aranıyor" 
                               TextColor="#BBB" FontSize="14" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#333" Margin="0,5"/>

                    <Button Text="🗺️  HARİTADA GÖSTER" 
                            Clicked="OnMapClicked"
                            BackgroundColor="#0A0A0A" 
                            TextColor="White" 
                            BorderColor="#E01111" BorderWidth="1.5"
                            FontAttributes="Bold"
                            HeightRequest="55" CornerRadius="12">
                        <Button.Shadow>
                            <Shadow Brush="Red" Offset="0,0" Radius="15" Opacity="0.3" />
                        </Button.Shadow>
                    </Button>

                    <Button Text="✅  KABUL ET / GİDİYORUM" 
                            Clicked="OnHelpClicked"
                            BackgroundColor="#00C853" 
                            TextColor="White" FontAttributes="Bold"
                            HeightRequest="55" CornerRadius="12"/>

                    <Button Text="Kapat" 
                            Clicked="OnIgnoreClicked"
                            BackgroundColor="Transparent" TextColor="#666" FontSize="14"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>