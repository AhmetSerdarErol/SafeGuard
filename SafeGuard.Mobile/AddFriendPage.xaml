<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeGuard.Mobile.Views.AddFriendPage"
             Title="Yakın Ekle"
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Padding="20,20,20,0">
            <Label Grid.Column="0" Text="⬅" TextColor="White" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" Padding="0,0,15,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Yakın Ekle" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Grid.Column="2" WidthRequest="30" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto, *" Padding="24, 32, 24, 32">

            <VerticalStackLayout Grid.Row="0" Spacing="16" HorizontalOptions="Center" Margin="0,0,0,40">
                <Border StrokeShape="RoundRectangle 40" 
                        HeightRequest="80" 
                        WidthRequest="80" 
                        BackgroundColor="#1E1E1E" 
                        Stroke="#333333"
                        HorizontalOptions="Center">
                    <Label Text="🛡️" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="Güvenilir Kişi Ekle" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="#FFFFFF" 
                       HorizontalTextAlignment="Center" />

                <Label Text="Acil durumlarda konumunuzun anında SMS ve bildirim olarak iletileceği kişiyi belirleyin."
                       FontSize="15" 
                       TextColor="#A0A0A0" 
                       HorizontalTextAlignment="Center" 
                       LineHeight="1.4" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="10">
                <Label Text="TELEFON NUMARASI" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       TextColor="#A0A0A0" 
                       Margin="4,0,0,0" />

                <Border StrokeShape="RoundRectangle 12" 
                        Stroke="#333333" 
                        StrokeThickness="1.5" 
                        BackgroundColor="#1E1E1E" 
                        HeightRequest="60" 
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto, Auto, *">
                        <Label Text="🇹🇷" 
                               Grid.Column="0" 
                               FontSize="22" 
                               VerticalOptions="Center" 
                               Margin="0,0,8,0" />

                        <Label Text="+90" 
                               Grid.Column="1" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#FFFFFF" 
                               VerticalOptions="Center" 
                               Margin="0,0,12,0" />

                        <BoxView Grid.Column="1" 
                                 Color="#444444" 
                                 WidthRequest="1" 
                                 HeightRequest="24" 
                                 HorizontalOptions="End" 
                                 VerticalOptions="Center" 
                                 Margin="0,0,-8,0" />

                        <Entry x:Name="PhoneEntry"
                               Grid.Column="2" 
                               Placeholder="5XX XXX XX XX" 
                               PlaceholderColor="#666666"
                               Keyboard="Telephone" 
                               MaxLength="10" 
                               BackgroundColor="Transparent" 
                               TextColor="#FFFFFF"
                               FontSize="18"
                               VerticalOptions="Center"
                               Margin="12,0,0,0" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Button x:Name="SendRequestBtn"
                    Grid.Row="2"
                    Text="Kaydet ve Ekle" 
                    BackgroundColor="#D32F2F" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    CornerRadius="14" 
                    HeightRequest="56" 
                    Clicked="OnSendRequestClicked" />

            <CollectionView x:Name="ContactsList" Grid.Row="3" Margin="0,20,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#333333" BackgroundColor="#1E1E1E" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,5">
                            <Label Text="{Binding Name}" TextColor="#FFFFFF" FontSize="16" FontAttributes="Bold" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>