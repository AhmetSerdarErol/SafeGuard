<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeGuard.Mobile.Views.ProfilePage"
             Title="Tıbbi Kimlik ve Profil" 
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,40,20,100">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                    <Label Grid.Column="0" Text="⬅" TextColor="White" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" Padding="0,0,15,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Column="1" Text="Tıbbi Kimlik" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>

                    <Button Grid.Column="2" x:Name="EditButton" Text="Düzenle ✎" BackgroundColor="Transparent" TextColor="#FF3B30" FontAttributes="Bold" Clicked="OnEditClicked" VerticalOptions="Center"/>
                </Grid>

                <VerticalStackLayout HorizontalOptions="Center" Margin="0,10,0,10">
                    <Border Stroke="#2196F3" StrokeThickness="3" HeightRequest="120" WidthRequest="120" StrokeShape="RoundRectangle 60" BackgroundColor="#1E1E1E">
                        <Grid>
                            <Image x:Name="ProfileImage" Aspect="AspectFill" BackgroundColor="Transparent"/>
                            <Label x:Name="InitialsLabel" Text="AD" FontSize="40" FontAttributes="Bold" TextColor="#2196F3" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangePhotoClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Label x:Name="PhotoChangeHint" Text="Fotoğrafı Değiştir" TextColor="#2196F3" FontSize="14" HorizontalOptions="Center" IsVisible="False" Margin="0,10,0,0"/>
                </VerticalStackLayout>

                <Label Text="TEMEL VE FİZİKSEL BİLGİLER" TextColor="#8E8E93" FontSize="12" FontAttributes="Bold" Margin="5,10,0,0"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Ad Soyad" TextColor="#8E8E93" FontSize="12"/>
                            <Entry x:Name="NameEntry" TextColor="White" IsReadOnly="True" BackgroundColor="Transparent" FontSize="16" Margin="-5,0,0,0"/>
                            <BoxView HeightRequest="1" Color="#333333"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Telefon Numarası" TextColor="#8E8E93" FontSize="12"/>
                            <Entry x:Name="PhoneEntry" Keyboard="Telephone" TextColor="White" IsReadOnly="True" BackgroundColor="Transparent" FontSize="16" Margin="-5,0,0,0"/>
                            <BoxView HeightRequest="1" Color="#333333"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Boy (cm)" TextColor="#8E8E93" FontSize="12"/>
                                <Entry x:Name="HeightEntry" Keyboard="Numeric" TextColor="White" IsReadOnly="True" BackgroundColor="Transparent" FontSize="16" Margin="-5,0,0,0"/>
                                <BoxView HeightRequest="1" Color="#333333"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Kilo (kg)" TextColor="#8E8E93" FontSize="12"/>
                                <Entry x:Name="WeightEntry" Keyboard="Numeric" TextColor="White" IsReadOnly="True" BackgroundColor="Transparent" FontSize="16" Margin="-5,0,0,0"/>
                                <BoxView HeightRequest="1" Color="#333333"/>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Kan Grubu" TextColor="#8E8E93" FontSize="12"/>
                            <Picker x:Name="BloodPicker" Title="Seçiniz" IsEnabled="False" TextColor="#FF3B30" FontAttributes="Bold" BackgroundColor="Transparent" Margin="-5,0,0,0">
                                <Picker.Items>
                                    <x:String>A Rh+</x:String>
                                    <x:String>A Rh-</x:String>
                                    <x:String>B Rh+</x:String>
                                    <x:String>B Rh-</x:String>
                                    <x:String>AB Rh+</x:String>
                                    <x:String>AB Rh-</x:String>
                                    <x:String>0 Rh+</x:String>
                                    <x:String>0 Rh-</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="TIBBİ BİLGİLER" TextColor="#8E8E93" FontSize="12" FontAttributes="Bold" Margin="5,10,0,0"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Tıbbi Durumlar / Hastalıklar" TextColor="#8E8E93" FontSize="12"/>
                            <Entry x:Name="ConditionsEntry" Placeholder="Örn: Astım, Tansiyon (Yoksa boş bırakın)" PlaceholderColor="#555555" TextColor="White" IsReadOnly="True" BackgroundColor="Transparent" FontSize="14" Margin="-5,0,0,0"/>
                            <BoxView HeightRequest="1" Color="#333333"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Alerjiler ve Reaksiyonlar" TextColor="#8E8E93" FontSize="12"/>
                            <Entry x:Name="AllergiesEntry" Placeholder="Örn: Penisilin, Fıstık" PlaceholderColor="#555555" TextColor="White" IsReadOnly="True" BackgroundColor="Transparent" FontSize="14" Margin="-5,0,0,0"/>
                            <BoxView HeightRequest="1" Color="#333333"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Kullandığı İlaçlar" TextColor="#8E8E93" FontSize="12"/>
                            <Entry x:Name="MedicationsEntry" Placeholder="Düzenli alınan ilaçlar" PlaceholderColor="#555555" TextColor="White" IsReadOnly="True" BackgroundColor="Transparent" FontSize="14" Margin="-5,0,0,0"/>
                            <BoxView HeightRequest="1" Color="#333333"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Organ Nakli / Bağışı Durumu" TextColor="#8E8E93" FontSize="12"/>
                            <Picker x:Name="OrganStatusPicker" Title="Seçiniz" IsEnabled="False" TextColor="White" SelectedIndexChanged="OnOrganStatusChanged" BackgroundColor="Transparent" Margin="-5,0,0,0">
                                <Picker.Items>
                                    <x:String>Yok</x:String>
                                    <x:String>Nakil Aldım (Alıcı)</x:String>
                                    <x:String>Organ Bağışladım (Verici)</x:String>
                                </Picker.Items>
                            </Picker>
                            <BoxView HeightRequest="1" Color="#333333"/>
                        </VerticalStackLayout>

                        <Entry x:Name="OrganDetailsEntry" Placeholder="Hangi organ? (Örn: Böbrek)" PlaceholderColor="#555555" TextColor="White" IsReadOnly="True" IsVisible="False" BackgroundColor="Transparent" FontSize="14" Margin="-5,0,0,0"/>

                    </VerticalStackLayout>
                </Border>

                <Label Text="ALIŞKANLIKLAR" TextColor="#8E8E93" FontSize="12" FontAttributes="Bold" Margin="5,10,0,0"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Alkol Kullanımı" TextColor="#8E8E93" FontSize="12"/>
                            <Picker x:Name="AlcoholPicker" Title="Seçiniz" IsEnabled="False" TextColor="White" BackgroundColor="Transparent" Margin="-5,0,0,0">
                                <Picker.Items>
                                    <x:String>Kullanmıyorum</x:String>
                                    <x:String>Ara Sıra</x:String>
                                    <x:String>Düzenli</x:String>
                                </Picker.Items>
                            </Picker>
                            <BoxView HeightRequest="1" Color="#333333"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Sigara Kullanımı" TextColor="#8E8E93" FontSize="12"/>
                            <Picker x:Name="SmokingPicker" Title="Seçiniz" IsEnabled="False" TextColor="White" BackgroundColor="Transparent" Margin="-5,0,0,0">
                                <Picker.Items>
                                    <x:String>Kullanmıyorum</x:String>
                                    <x:String>Bıraktım</x:String>
                                    <x:String>Kullanıyorum</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button x:Name="LogoutButton" Text="Sistemden Çıkış Yap" BackgroundColor="Transparent" TextColor="#FF3B30" FontAttributes="Bold" Clicked="OnLogoutClicked" Margin="0,10,0,20"/>

            </VerticalStackLayout>
        </ScrollView>

        <Border x:Name="SaveContainer" BackgroundColor="#1C1C1E" Stroke="#333333" StrokeThickness="1" VerticalOptions="End" Padding="20" IsVisible="False" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.8" Radius="15" Offset="0,-10"/>
            </Border.Shadow>
            <Button Text="BİLGİLERİ KAYDET" BackgroundColor="#2196F3" TextColor="White" HeightRequest="55" CornerRadius="12" FontAttributes="Bold" Clicked="OnSaveClicked"/>
        </Border>

    </Grid>
</ContentPage>